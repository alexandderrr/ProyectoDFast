spring.application.name=dfast

# Conexión a PostgreSQL (Base de datos dfast_db)
spring.datasource.url=jdbc:postgresql://localhost:5432/dfast_db
spring.datasource.username=postgres
spring.datasource.password=contraseña personal postgres

# Configuración de Hibernate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Clave de Google Maps (Maps JavaScript API, Geocoding API y Directions API)
# Déjala vacía para ver el mapa de referencia sin conexión a Google
google.maps.api.key=
